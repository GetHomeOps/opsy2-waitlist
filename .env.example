# --- Server secrets (never expose these to the browser) ---

# Stripe restricted or secret key. Used only on the server for Checkout + webhooks.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret for POST /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Opsy Supabase project. Waitlist tables live in the landing schema, not public.
# Server uses the service role; the browser never sees this.
SUPABASE_URL=https://kxsgsoegupzgdmibijsk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard password (httpOnly session cookie).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional public origin used for Checkout success/cancel URLs.
# Defaults to the current host or the Vercel URL.
APP_URL=

# Amazon SES (us-east-2). The From address must be a verified SES identity.
# AWS SDK also reads AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
AWS_REGION=us-east-2
SES_FROM_EMAIL=waitlist@heyopsy.com
SES_FROM_NAME=Opsy
SES_REPLY_TO=

# --- Legacy public Payment Links (no longer used by checkout) ---
VITE_STRIPE_CHECKOUT_ONE=
VITE_STRIPE_CHECKOUT_THREE=
VITE_STRIPE_CHECKOUT_FIVE=
